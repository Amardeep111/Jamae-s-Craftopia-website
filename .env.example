# Supabase PostgreSQL
# Runtime: Supabase transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Prisma migrations: Supabase session pooler or direct connection.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
USE_MOCK_DATA="false"

# Authentication secrets. Generate fresh values; keep the RSA private key server-side.
AUTH_SECRET=""
SESSION_COOKIE_SECRET=""
PASSWORD_ENCRYPTION_PRIVATE_KEY=""

# Gmail SMTP. Required for signup and password verification emails.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional: defaults to the Gmail account above.
EMAIL_FROM=""
# Optional: receives custom request, contact, order, and refund notifications.
SUPPORT_EMAIL=""

# Manual UPI checkout details. These can also be set in Admin > Payment settings.
MERCHANT_UPI_ID=""
MERCHANT_PAYEE_NAME="Jamae's Craftopia"
# Optional: payment proof link fallback when no number is saved in Admin settings.
WHATSAPP_CONTACT_NUMBER=""

# Cloudinary signed image uploads. Get these from Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: map/geocoding features. Use a restricted public token for the browser token.
MAPBOX_ACCESS_TOKEN=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Optional: canonical production origin for links in emails. Vercel supplies VERCEL_URL otherwise.
APP_URL=""
