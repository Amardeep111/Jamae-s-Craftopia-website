# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jamaes_craftopia?schema=public"

# For Supabase, use:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Image Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Mock Mode (set to "true" to use mock data without database)
USE_MOCK_DATA="false"

# Google Maps Platform (deprecated for this feature; kept for compatibility)
# GOOGLE_MAPS_API_KEY=""
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"

# Mapbox — used for the interactive "Use your current location" picker.
# 1. Get a token at https://mapbox.com/ and add URL referrer restrictions.
# 2. The NEXT_PUBLIC_MAPBOX_TOKEN is exposed to the browser for tile rendering.
# 3. The MAPBOX_ACCESS_TOKEN is server-only and used for reverse geocoding at /api/geocode.
MAPBOX_ACCESS_TOKEN=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Admin Secret (for API authentication)
ADMIN_SECRET=""

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
